# CyberSec Lab - Environment Variables
# Copy this file to .env and fill in the values

# Application
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database
# Prisma database URL — PostgreSQL required
# For local development without Docker, use a free PostgreSQL service:
# Neon: https://neon.tech
# Supabase: https://supabase.com
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybersec_lab"

# Token signing secret (must be at least 32 characters)
# Generate a strong secret: openssl rand -base64 32
TOKEN_SECRET="your-super-secret-token-key-change-this-in-production"

# OTP Configuration (for password recovery)
OTP_SECRET="your-otp-secret-change-this"
OTP_EXPIRY_MINUTES=10

# Email (optional - for password recovery and deadline reminder notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@cyberseclab.com"

# Admin invite code (optional - required for registering admin accounts)
# ADMIN_INVITE_CODE="your-admin-invite-code"
