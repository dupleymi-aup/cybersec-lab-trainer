# ─── Application ───────────────────────────────────────────────
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Database ──────────────────────────────────────────────────
# PostgreSQL connection string (used when DB sync is enabled)
# Format: postgresql://user:password@host:5432/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cybersec_lab

# ─── Authentication ────────────────────────────────────────────
# JWT signing secret (server-only, never expose to client)
# Generate with: openssl rand -base64 32
TOKEN_SECRET=dev-secret-change-in-production
