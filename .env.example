# CyberSec Lab - Environment Variables
# Copy this file to .env.local and fill in the values

# Database
# Prisma database URL — PostgreSQL required
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cybersec_lab"

# For local development without Docker, you can use a free PostgreSQL service:
# Neon: https://neon.tech
# Supabase: https://supabase.com

# JWT Configuration
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# OTP Configuration (for password recovery)
OTP_SECRET="your-otp-secret-change-this"
OTP_EXPIRY_MINUTES=10

# Server Configuration
NODE_ENV="development"
PORT=3000

# Security
# Session secret for CSRF protection (if implemented)
SESSION_SECRET="your-session-secret-change-this"

# Email (optional - for password recovery and deadline reminder notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@cyberseclab.com"

# External API Keys (optional)
# HAVE_I_BEEN_PWNED_API_KEY=""
# VIRUSTOTAL_API_KEY=""

# Logging
LOG_LEVEL="info"
