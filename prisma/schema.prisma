// CyberSec Lab Trainer — Prisma Schema
// PostgreSQL database for user management, progress tracking, and audit logging

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  phone        String    @unique
  fullName     String
  group        String    @default("")
  course       String    @default("")
  university   String    @default("")
  avatar       String    @default("")
  bio          String    @default("")
  role         String    @default("student")  // student, teacher, admin
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now())       @map("created_at")
  lastLoginAt  DateTime?                       @map("last_login_at")
  loginCount   Int       @default(0)           @map("login_count")
  isBlocked    Boolean   @default(false)       @map("is_blocked")
  xp           Int       @default(0)           // experience points
  level        Int       @default(1)           // 1-50: Junior(1-10) → Mid(11-20) → Senior(21-35) → Lead(36-50)
  streak       Int       @default(0)           // consecutive days active
  lastActivityAt DateTime?                     @map("last_activity_at")  // for streak calculation

  progress          Progress[]
  quizResults       QuizResult[]
  auditLogs         AuditLog[]       @relation("AdminAuditLogs")
  loginActivities   LoginActivity[]
  quizAttempts      QuizAttempt[]
  progressSnapshots ProgressSnapshot[]
  createdDeadlines  Deadline[]       @relation("DeadlineCreator")
  reminderLogs      ReminderLog[]
  scheduledReports  ScheduledReport[]
  createdAssignments Assignment[] @relation("AssignmentCreator")
  assignmentSubmissions AssignmentSubmission[]

  @@map("users")
}

model Progress {
  id                     String   @id @default(cuid())
  userId                 String   @map("user_id")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId               String   @map("module_id")  // owasp, sql-injection, xss, csrf, auth, secure-coding, tools, security-headers
  completed              Boolean  @default(false)
  score                  Int?     // 0-100
  sqlLevels              String   @default("")       @map("sql_levels")
  xssLevels              String   @default("")       @map("xss_levels")
  csrfSteps              String   @default("")       @map("csrf_steps")
  csrfChallengeScores    String   @default("")       @map("csrf_challenge_scores")
  secureCodingAnswers    String   @default("")       @map("secure_coding_answers")
  secureCodingCorrectCount Int    @default(0)        @map("secure_coding_correct_count")
  studiedOwaspItems      String   @default("")       @map("studied_owasp_items")
  challengeScores        String?  @map("challenge_scores")  // JSON string: { owasp, auth, headers }
  updatedAt              DateTime @updatedAt         @map("updated_at")

  @@unique([userId, moduleId])
  @@map("progress")
}

model QuizResult {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId     String   @map("quiz_id")  // category: sql, xss, csrf, auth, general, owasp, coding, network, social
  score      Int      // correct answers
  total      Int      // total questions
  percentage Int      // computed: round(score/total * 100)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([userId, quizId])
  @@map("quiz_results")
}

model LoginActivity {
  id        String   @id @default(cuid())
  userId    String?  @map("user_id")
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  email     String?
  ip        String
  userAgent String   @map("user_agent")
  success   Boolean
  timestamp DateTime @default(now())

  @@map("login_activity")
}

model AuditLog {
  id         String   @id @default(cuid())
  adminId    String   @map("admin_id")
  admin      User     @relation("AdminAuditLogs", fields: [adminId], references: [id], onDelete: Cascade)
  adminName  String   @map("admin_name")
  action     String   // role_change, user_created, user_deleted, user_blocked, impersonation, bulk_operation
  targetId   String   @map("target_id")
  targetName String   @map("target_name")
  details    String   @default("")
  timestamp  DateTime @default(now())

  @@map("audit_logs")
}

model QuizAttempt {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizId      String   @map("quiz_id")
  questionId  String   @map("question_id")
  difficulty  String
  category    String
  correct     Boolean
  attemptedAt DateTime @default(now()) @map("attempted_at")

  @@index([questionId])
  @@index([userId, quizId])
  @@map("quiz_attempts")
}

model ProgressSnapshot {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleId   String   @map("module_id")
  score      Int
  completed  Boolean
  recordedAt DateTime @default(now()) @map("recorded_at")

  @@index([userId, recordedAt])
  @@map("progress_snapshots")
}

model Deadline {
  id          String   @id @default(cuid())
  scope       String   // "course" | "module" | "quiz"
  scopeId     String   @map("scope_id")
  dueAt       DateTime @map("due_at")
  title       String
  description String   @default("")
  group       String   @default("")  // "" = all students
  createdAt   DateTime @default(now()) @map("created_at")
  createdBy   String   @map("created_by")
  creator     User     @relation("DeadlineCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  reminderLog ReminderLog[]

  @@index([scope, scopeId])
  @@index([group])
  @@index([dueAt])
  @@map("deadlines")
}

model ReminderLog {
  id         String   @id @default(cuid())
  deadlineId String   @map("deadline_id")
  deadline   Deadline @relation(fields: [deadlineId], references: [id], onDelete: Cascade)
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // "email" | "in-app"
  sentAt     DateTime @default(now()) @map("sent_at")

  @@unique([deadlineId, userId, type])
  @@index([userId])
  @@map("reminder_logs")
}

model ScheduledReport {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportType     String    @map("report_type")  // "gradebook" | "at-risk" | "analytics" | "module-performance" | "quiz-retry" | "student-report"
  frequency      String    // "daily" | "weekly" | "monthly"
  dayOfWeek      Int?      @map("day_of_week")  // 0-6 (Sun-Sat), for weekly
  dayOfMonth     Int?      @map("day_of_month") // 1-31, for monthly
  email          String    @default("")
  groupId        String    @default("")          @map("group_id")
  days           Int       @default(30)          // lookback period
  isActive       Boolean   @default(true)        @map("is_active")
  lastGenerated  DateTime? @map("last_generated")
  createdAt      DateTime  @default(now())       @map("created_at")

  @@index([userId, isActive])
  @@index([frequency])
  @@map("scheduled_reports")
}

model LtiPlatform {
  id             String   @id @default(cuid())
  name           String                          // "Moodle", "Canvas", etc.
  issuer         String   @unique                // OIDC issuer URL
  clientId       String   @unique                // OAuth2 client ID
  authUrl        String   @map("auth_url")       // OIDC auth endpoint
  tokenUrl       String   @map("token_url")      // Token endpoint
  keysetUrl      String   @map("keyset_url")     // JWKS endpoint
  deploymentId   String   @map("deployment_id")  // LTI deployment ID
  publicKey      String   @map("public_key")     // Platform public key (PEM)
  privateKey     String?  @map("private_key")    // Our private key (PEM) for AGS
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  gradeSyncs     LtiGradeSync[]
  launchLogs     LtiLaunchLog[]

  @@map("lti_platforms")
}

model LtiGradeSync {
  id          String   @id @default(cuid())
  platformId  String   @map("platform_id")
  platform    LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId      String   @map("user_id")
  lineitemId  String   @map("lineitem_id")    // AGS line item ID
  lineitemLabel String @default("") @map("lineitem_label")  // e.g. "OWASP Module"
  score       Float    // score achieved
  scoreMaximum Float   @map("score_maximum")  // max possible score
  status      String   @default("pending")    // pending, synced, failed
  syncedAt    DateTime? @map("synced_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([platformId, userId])
  @@index([status])
  @@map("lti_grade_sync")
}

model LtiLaunchLog {
  id          String   @id @default(cuid())
  platformId  String   @map("platform_id")
  platform    LtiPlatform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  userId      String?  @map("user_id")
  email       String?
  launchType  String   @map("launch_type")  // full, deep-link
  resourceId  String?  @map("resource_id")  // module/quiz ID
  ip          String
  userAgent   String   @map("user_agent")
  success     Boolean
  message     String   @default("")
  launchedAt  DateTime @default(now()) @map("launched_at")

  @@index([platformId, launchedAt])
  @@index([userId])
  @@map("lti_launch_logs")
}

model Announcement {
  id         String   @id @default(cuid())
  title      String
  content    String
  author     String   // author name/email
  priority   String   @default("normal")  // low, normal, high
  active     Boolean  @default(true)
  expiresAt  DateTime? @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([active, expiresAt])
  @@map("announcements")
}

model Assignment {
  id          String   @id @default(cuid())
  title       String
  description String   @default("")
  type        String   // "quiz" | "code-review" | "attack" | "writeup" | "custom"
  moduleId    String   @default("") @map("module_id")  // optional: tie to existing module
  content     String   @default("")  // JSON: quiz questions, code samples, instructions
  maxScore    Int      @default(100) @map("max_score")
  passScore   Int      @default(60) @map("pass_score")  // percentage to pass
  autoGrade   Boolean  @default(false) @map("auto_grade")  // enable auto-grading
  timeLimit   Int?     @map("time_limit")  // minutes, null = no limit
  attempts    Int      @default(1)   // max attempts, 0 = unlimited
  group       String   @default("")  // "" = all students
  dueAt       DateTime? @map("due_at")
  published   Boolean  @default(false)
  createdBy   String   @map("created_by")
  creator     User     @relation("AssignmentCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submissions AssignmentSubmission[]

  @@index([createdBy, published])
  @@index([group])
  @@index([dueAt])
  @@map("assignments")
}

model AssignmentSubmission {
  id           String   @id @default(cuid())
  assignmentId String   @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  content      String   @default("")  // JSON: answers, code, writeup
  score        Int?     // auto or manual grade
  maxScore     Int      @map("max_score")  // snapshot from assignment
  passed       Boolean? // whether they passed
  attempt      Int      @default(1)   // attempt number
  startedAt    DateTime @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")
  gradedAt     DateTime? @map("graded_at")
  gradedBy     String?  @map("graded_by")  // teacher who graded

  @@unique([assignmentId, userId, attempt])
  @@index([userId])
  @@index([assignmentId])
  @@index([submittedAt])
  @@map("assignment_submissions")
}
